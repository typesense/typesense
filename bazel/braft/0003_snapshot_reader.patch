+SnapshotReader* NodeImpl::open_snapshot_reader() {
+    if (_snapshot_executor == NULL || _snapshot_executor->snapshot_storage() == NULL) {
+        return NULL;
+    }
+    return _snapshot_executor->snapshot_storage()->open();
+}
+
+int NodeImpl::close_snapshot_reader(SnapshotReader* reader) {
+    if (_snapshot_executor == NULL || _snapshot_executor->snapshot_storage() == NULL || reader == NULL) {
+        return -1;
+    }
+    return _snapshot_executor->snapshot_storage()->close(reader);
+}
